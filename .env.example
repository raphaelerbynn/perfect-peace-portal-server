# Copy to .env and fill in. Used BOTH by docker-compose (for ${VAR} interpolation)
# and by the backend container (env_file). Never commit the real .env.

# --- Database (PostgreSQL) ---
DB_NAME=perfectpeace
DB_USERNAME=perfectpeace
DB_PASSWORD=change-me-strong-password
# DB_HOST/DB_PORT are OVERRIDDEN by docker-compose to point at the `db` service.
# For running the app OUTSIDE docker against the container, use:
DB_HOST=localhost
DB_PORT=5432

# --- API ---
SERVER_PORT=5050
# Strong random secret — rotating invalidates all existing sessions.
JWT_KEY=
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMS (Arkesel) ---
ARKESEL_KEY=
# Must match the sender ID registered with Arkesel.
SMS_SENDER_ID=PPeace Sch

# --- Google Drive (assignment files) — names read by src/controllers/fileController.js ---
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
REFRESH_TOKEN=
ACCESS_TOKEN=
# Drive folder that holds assignment files.
DESTINATION_FOLDER_ID=
# One-off Drive setup (/auth/google prints a refresh token to the log). Leave unset in production.
# DRIVE_SETUP=true

# --- Behind a reverse proxy (nginx / Apache / Passenger / load balancer) ---
# Number of proxy hops, so sign-in rate limits see the real client IP. Usually 1.
# TRUST_PROXY=1
# Wide per-IP ceiling on sign-in attempts per 10 minutes (the per-account limit is 20).
# AUTH_IP_LIMIT=300

# --- pgAdmin (docker-compose.yml, LOCAL ONLY — production uses docker-compose.prod.yml, no pgAdmin) ---
PGADMIN_EMAIL=admin@perfectpeace.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051

# --- B17: photos, documents and the school logo ---
# Where files are kept: local (default: a folder on this server) or s3 (MinIO,
# or any S3-compatible store). The Docker compose files run MinIO and set these
# for the API; set them here only when running the API outside Docker.
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=http://localhost:9000     # MinIO's S3 API (not the 9001 console)
#   S3_BUCKET=perfect-peace               # created on first start, private
#   S3_ACCESS_KEY=ppminio
#   S3_SECRET_KEY=ppminio-dev-password
#   S3_REGION=us-east-1                   # optional
#   S3_FORCE_PATH_STYLE=true              # optional; MinIO needs true
STORAGE_DRIVER=
# MinIO (docker compose): root login, also used by the API. Production: 16+ random chars.
# MINIO_ROOT_USER=ppminio
# MINIO_ROOT_PASSWORD=ppminio-dev-password
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest   # official minio/minio can no longer be pulled
#
# STORAGE_DRIVER=local: folder on the server where uploaded files are kept (created on first upload).
# Keep it OUTSIDE the code folder and include it in the server backup.
# Default: ./uploads next to where the API starts. In Docker: /app/uploads (a volume).
UPLOAD_DIR=

# --- B16: email notifications ---
# log (default): write "would send" lines to the log and send nothing.
# smtp: send through the SMTP server below. off: no email at all.
# A missing SMTP setting never stops the API: it falls back to log.
EMAIL_DRIVER=log
# Gmail (a dedicated school Gmail account; turn on 2-step verification, then
# create an "App password" and paste it as SMTP_PASS - not the normal password):
#   EMAIL_DRIVER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465                 # 465 = TLS from the start; 587 = STARTTLS (both work)
#   SMTP_USER=perfectpeace.school@gmail.com
#   SMTP_PASS=abcdefghijklmnop    # the 16-letter app password
#   EMAIL_FROM=perfectpeace.school@gmail.com   # Gmail sends as the account itself
#   EMAIL_FROM_NAME=Perfect Peace School
# SMTP_SECURE=true|false overrides the port rule (465 = true, anything else = STARTTLS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Gmail allows about 500 emails a day: stop at this many SENT per day (UTC); the
# rest are logged as FAILED in Email_log. 0 = no limit (a paid provider).
# EMAIL_DAILY_LIMIT=450
# Emails go out in batches with a pause between them.
# EMAIL_BATCH_SIZE=20
# EMAIL_BATCH_PAUSE_MS=2000
# Links in emails ("Open" button). Without them the email has no button.
# PORTAL_URL=https://portal.perfectpeace.example
# ADMIN_URL=https://perfectpeace.vercel.app

# --- AI-0: AI assistant (Google Gemini) ---
# OFF unless AI_ENABLED=true AND a key is set. Even then nothing is sent until an
# Administrator switches AI on in the admin app (Settings -> AI), which also holds
# the per-feature switches and the monthly cap. Without these the app works as before.
AI_ENABLED=false
# From https://aistudio.google.com/apikey (a paid key; keep it out of git).
GEMINI_API_KEY=
# Model for every AI feature.
AI_MODEL_DEFAULT=gemini-3.1-flash-lite
# Monthly spending cap in GH₵ used until the Administrator sets one on Settings -> AI.
# When this month's spend reaches the cap, AI features stop until next month.
AI_MONTHLY_BUDGET_GHS=200
# Cedis per US dollar, to turn Google's USD prices into GH₵ (update now and then).
AI_USD_TO_GHS=15.5
# Optional:
# AI_REQUEST_TIMEOUT_MS=60000     # per attempt
# AI_MAX_RETRIES=2                # busy / timed-out calls are retried this many times
# AI_RETRY_BASE_DELAY_MS=500
# AI_MAX_TOOL_ITERATIONS=5        # "Ask the school": most tool rounds per question
# AI_PRICES_JSON={"gemini-3.1-flash-lite":{"input":0.25,"cached":0.025,"output":1.5}}  # USD per million tokens
# AI_FAKE_PROVIDER=1              # development only: canned answers, no key, no network (ignored in production)

# --- AI-5: Monday briefing ---
# Made on the days / time the Administrator picks (default Monday 06:00,
# Africa/Accra), only while AI is on. Set to "off" on a second API instance
# (optional: the day key already stops a second briefing).
# BRIEFING_SCHEDULER=on
# WhatsApp copy to the head teacher (when ticked on the Briefings page):
#   log   (default) write "would send" to the console, send nothing
#   cloud Meta WhatsApp Cloud API, plain text from the school's business number.
#         Free text only reaches someone who messaged that number in the last
#         24 hours; otherwise Meta needs an approved template (it is recorded
#         as FAILED, the in-app briefing is unaffected).
#   off   nothing at all
WHATSAPP_DRIVER=log
# WHATSAPP_TOKEN=                 # system-user access token (Meta Business settings)
# WHATSAPP_PHONE_NUMBER_ID=       # the sender number's id (WhatsApp Manager -> API setup)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TIMEOUT_MS=15000
