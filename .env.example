# Copy to .env and fill in. Used BOTH by docker-compose (for ${VAR} interpolation)
# and by the backend container (env_file). Never commit the real .env.

# --- Database (PostgreSQL) ---
DB_NAME=perfectpeace
DB_USERNAME=perfectpeace
DB_PASSWORD=change-me-strong-password
# DB_HOST/DB_PORT are OVERRIDDEN by docker-compose to point at the `db` service.
# For running the app OUTSIDE docker against the container, use:
DB_HOST=localhost
DB_PORT=5432

# --- API ---
SERVER_PORT=5050
# Strong random secret — rotating invalidates all existing sessions.
JWT_KEY=
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMS (Arkesel) ---
ARKESEL_KEY=
# Must match the sender ID registered with Arkesel.
SMS_SENDER_ID=PPeace Sch

# --- Google Drive (assignment files) ---
# Provide whatever the fileController expects (credentials path / refresh token).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- pgAdmin (docker-compose only) ---
PGADMIN_EMAIL=admin@perfectpeace.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051
