# Copy to .env and fill in. Used BOTH by docker-compose (for ${VAR} interpolation)
# and by the backend container (env_file). Never commit the real .env.

# --- Database (PostgreSQL) ---
DB_NAME=perfectpeace
DB_USERNAME=perfectpeace
DB_PASSWORD=change-me-strong-password
# DB_HOST/DB_PORT are OVERRIDDEN by docker-compose to point at the `db` service.
# For running the app OUTSIDE docker against the container, use:
DB_HOST=localhost
DB_PORT=5432

# --- API ---
SERVER_PORT=5050
# Strong random secret — rotating invalidates all existing sessions.
JWT_KEY=
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMS (Arkesel) ---
ARKESEL_KEY=
# Must match the sender ID registered with Arkesel.
SMS_SENDER_ID=PPeace Sch

# --- Google Drive (assignment files) — names read by src/controllers/fileController.js ---
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
REFRESH_TOKEN=
ACCESS_TOKEN=
# Drive folder that holds assignment files.
DESTINATION_FOLDER_ID=
# One-off Drive setup (/auth/google prints a refresh token to the log). Leave unset in production.
# DRIVE_SETUP=true

# --- Behind a reverse proxy (nginx / Apache / Passenger / load balancer) ---
# Number of proxy hops, so sign-in rate limits see the real client IP. Usually 1.
# TRUST_PROXY=1
# Wide per-IP ceiling on sign-in attempts per 10 minutes (the per-account limit is 20).
# AUTH_IP_LIMIT=300

# --- pgAdmin (docker-compose.yml, LOCAL ONLY — production uses docker-compose.prod.yml, no pgAdmin) ---
PGADMIN_EMAIL=admin@perfectpeace.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051

