# LOCAL Docker stack config — used by docker-compose (both for ${VAR}
# interpolation via `--env-file .env.docker` AND as the backend container's
# env_file). Safe-to-share dev values ONLY. Never put production secrets here;
# the real prod secrets live in the dotenv-formatted `.env` (gitignored).
#
#   docker compose --env-file .env.docker up -d --build

# --- Database (PostgreSQL container) ---
DB_NAME=perfectpeace
DB_USERNAME=perfectpeace
DB_PASSWORD=perfectpeace_dev_pw
# Inside the compose network the backend reaches the db at host `db` (overridden
# in docker-compose.yml). DB_HOST/DB_PORT here set the HOST-side published port
# for reaching the container DB from your machine. Published on 5433 to avoid
# colliding with a local (Homebrew) Postgres already on 5432.
DB_HOST=localhost
DB_PORT=5433

# --- API ---
SERVER_PORT=5050
# Dev-only JWT secret. Rotate (any strong random string) for real deployments.
JWT_KEY=local_docker_dev_jwt_secret_change_me_0c1f2a3b4c5d6e7f
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# --- SMS (Arkesel) — left blank for local; SMS sends will just no-op/fail soft ---
ARKESEL_KEY=
SMS_SENDER_ID=PPeace Sch

# --- Google Drive (assignment files) — blank locally; file routes need these ---
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
ACCESS_TOKEN=
REFRESH_TOKEN=
DESTINATION_FOLDER_ID=

# --- pgAdmin (docker-compose only) ---
PGADMIN_EMAIL=admin@perfectpeace.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051
