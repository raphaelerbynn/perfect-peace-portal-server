# TEST-CLIENT env template. Copy to `.env.test-client` and fill in.
# On the VPS, the GitHub Actions deploy writes `.env.test-client` from repo
# secrets — do NOT commit a real `.env.test-client` (it is gitignored).
#
#   cp .env.test-client.example .env.test-client

# --- Temp database (ephemeral container; creds can be throwaway) ---
DB_NAME=perfectpeace_test
DB_USERNAME=perfectpeace
DB_PASSWORD=perfectpeace_test_pw

# --- API ---
# Published host port for the API. The container always listens on 5040.
SERVER_PORT=5040
# Per-deploy JWT secret — generate a strong random string (e.g. `openssl rand -hex 32`).
JWT_KEY=change_me_test_client_jwt_secret
# Add the client's frontend origin here once it is deployed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- The single admin account seeded on boot (seedAdmin.js) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@5040
ADMIN_EMAIL=admin@perfectpeace.test
ADMIN_NAME=Administrator

# --- Registry image (set by CI; overrides the compose default) ---
# e.g. ghcr.io/raphaelerbynn/perfect-peace-portal-server:test-client
BACKEND_IMAGE=

# --- Optional integrations (blank = disabled for the test client) ---
ARKESEL_KEY=
SMS_SENDER_ID=PPeace Sch
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
ACCESS_TOKEN=
REFRESH_TOKEN=
DESTINATION_FOLDER_ID=
